# SchemeSetu uses one env file per app:
#   server/.env  -> copy from server/.env.example (API, database, secrets, AI)
#   client/.env  -> copy from client/.env.example (VITE_API_BASE_URL)
# Never commit real .env files. All variables are documented in README.md.
#
# Quick reference (server):
NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=schemesetu
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
# Quick reference (client):
VITE_API_BASE_URL=/api/v1
