# Base URL of the SchemeSetu API as seen by the browser.
# Recommended: "/api/v1" — in development Vite proxies /api to the server, and on Vercel the
# rewrite in vercel.json forwards /api to Render, keeping auth cookies first-party.
# Only set a full URL (e.g. https://your-api.onrender.com/api/v1) if you deliberately call the
# API cross-site; then the server needs COOKIE_SAMESITE=none and CLIENT_URL set to this site.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server proxies /api (default http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
