# ---------------------------------------------------------------
# SchemeSetu API — copy to server/.env and fill in. Never commit .env.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=schemesetu

# Development only: run an embedded MongoDB persisted to server/.data/mongo
# (used automatically by `npm run dev:memory`). Never enable in production.
USE_EMBEDDED_MONGO=false

# JWT secrets — REQUIRED in production, at least 32 random characters each, different values.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Allowed browser origin(s) for CORS, comma-separated. Must match the frontend URL exactly.
CLIENT_URL=http://localhost:5173

# Cookie policy. Use "lax" when the frontend proxies /api (same-site, recommended).
# Use "none" only if the browser calls the API on a different site directly (requires HTTPS).
COOKIE_SAMESITE=lax
# Defaults to true in production or when COOKIE_SAMESITE=none.
# COOKIE_SECURE=true

# Number of reverse proxies in front of the app (Render: 1) so rate limiting sees real client IPs.
TRUST_PROXY=0


# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# ---- Scripts only (not read by the running server) ----
# npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# npm run seed:demo — password for the demo student account (min 8 chars)
DEMO_USER_PASSWORD=
